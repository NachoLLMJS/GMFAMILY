# Server-side only. Never prefix secrets with VITE_.
# GMGN_API_KEY can be loaded from an external file via GMGN_ENV_FILE.
GMGN_API_KEY=
GMGN_ENV_FILE=

# Optional external testnet deployer file. Keep it outside the repository.
GMFAMILY_TESTNET_ENV_FILE=

# Public official BNB Chain mainnet ERC-8004 Identity Registry.
# Override only after independently verifying replacement bytecode and ABI.
VITE_ERC8004_REGISTRY_ADDRESS=0x8004A169FB4a3325136EB29fA0ceB6D2e539a432
PORT=4174
